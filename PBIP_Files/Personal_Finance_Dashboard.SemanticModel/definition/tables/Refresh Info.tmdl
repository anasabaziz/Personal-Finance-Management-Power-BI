/// One row recording the import refresh timestamp in Malaysia time (UTC+8). This timestamp does not describe transaction coverage.
table 'Refresh Info'
	lineageTag: b19e298d-d43a-4f5d-8c19-ea0bd68a9042

	/// Time the model was refreshed, formatted in Malaysia time (UTC+8). Transaction dates can be older than this timestamp.
	measure 'Last Refreshed' = FORMAT(MAX('Refresh Info'[Refreshed At]), "d MMM yyyy h:mm AM/PM")
		formatString: @
		displayFolder: 'Data Quality'
		lineageTag: f1e10bc1-cea8-41e3-a090-d99ba46d9263

	/// Import refresh timestamp in Malaysia time (UTC+8).
	column 'Refreshed At'
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 5e6c08ad-8d98-4a56-a9b2-4edd7a00d960
		sourceColumn: Refreshed At

	partition 'Refresh Info' = m
		mode: import
		source =
				let
				    RefreshedAtMalaysia = DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FixedUtcNow(), 8)),
				    Source = #table(type table [Refreshed At = datetime], {{RefreshedAtMalaysia}})
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


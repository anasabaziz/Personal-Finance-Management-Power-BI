model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-MY
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["Affin_Credit_Card","Affin_Debit_Card","HSBC_Credit_Card","HSBC_Debit_Card","Maybank_Debit_Card","CIMB_Debit_Card","CIMB_Petronas_Credit_Card","CIMB_Rebate_Credit_card","TransactionListing","TransactionCategory_dim","DateCalendar","Owner_dim","Refresh Info","TransactionDataFolder"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table TransactionListing
ref table TransactionCategory_dim
ref table DateCalendar
ref table Owner_dim
ref table 'Refresh Info'

ref cultureInfo en-US


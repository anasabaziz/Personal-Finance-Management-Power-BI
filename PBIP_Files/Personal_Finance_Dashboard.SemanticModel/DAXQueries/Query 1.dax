// Full-data baseline. Standalone queries do not inherit report slicers.
// Spending includes investment contributions under the current category convention.
EVALUATE
    ROW(
        "Transaction count", COUNTROWS('TransactionListing'),
        "First transaction date", MIN('TransactionListing'[Date]),
        "Last transaction date", MAX('TransactionListing'[Date]),
        "Account count", DISTINCTCOUNT('TransactionListing'[Source]),
        "Income", [Total Income],
        "Signed expense", [Total Expense],
        "Spending", [Expense Amount],
        "Surplus", [Net Cash Flow],
        "Surplus rate", [Savings Rate],
        "All signed transactions", SUM('TransactionListing'[Amount]),
        "Other signed movements", SUM('TransactionListing'[Amount]) - [Net Cash Flow]
    )